{
  "name": "ucz",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "benchmark": "node benchmark/server.mjs",
    "build": "npm run build:worker && node scripts/build-dist.mjs",
    "preview": "vite preview",
    "test:p141:bounded": "node tests/p141-implementation.test.mjs",
    "test:ui": "node tests/run-ui.mjs",
    "test:codec": "node tests/run.mjs && node tests/worker.mjs && node --test tests/p10-baseline.test.mjs && node --test tests/p122-diagnostics.test.mjs && node --test tests/p13-diagnostics.test.mjs",
    "bench": "node scripts/run-bench.mjs",
    "diag:p9": "node scripts/diag/run-p9.mjs",
    "test:p9-recovery": "node --test tests/p9-recovery.test.mjs",
    "pretest:codec": "node scripts/build-worker-code.mjs --check",
    "test:p9-format": "node tests/run-p9-format.mjs",
    "test:p9-macro": "node tests/run-p9-macro.mjs",
    "check:worker": "node scripts/build-worker-code.mjs --check",
    "test:p9-defaults": "node tests/run-p9-defaults.mjs",
    "test:p10": "node tests/run-p10.mjs && node --test tests/p10-baseline.test.mjs",
    "test:p11": "node tests/run-p11.mjs && node --test tests/p10-baseline.test.mjs",
    "test:p111": "node tests/run-p111.mjs && node --test tests/p10-baseline.test.mjs",
    "build:worker": "node scripts/build-worker-code.mjs",
    "test:codec:bounded": "node tests/run-p12.mjs",
    "test:p131:bounded": "node tests/run-p131.mjs",
    "test:p13-diagnostics": "node --test tests/p13-diagnostics.test.mjs",
    "test:p13:bounded": "node tests/run-p13.mjs",
    "test:p12-diagnostics": "node --test tests/p122-diagnostics.test.mjs",
    "bench:corpus": "node scripts/run-bench.mjs",
    "bench:silesia": "node scripts/run-bench.mjs --corpus .diag-data/corpus --out bench-out/silesia --baseline",
    "bench:aitdcc": "node scripts/run-bench.mjs --corpus \"${UCZ_CORPUS:-../corpus/text}\" --out bench-out/aitdcc",
    "cli": "node dist/cli.js",
    "inspect": "node dist/cli.js inspect",
    "build:web": "vite build",
    "release:html": "npm run build:web && node scripts/package-release.mjs",
    "bench:quick": "node scripts/bench-public.mjs",
    "prepack": "npm run build",
    "prebench:quick": "node -e \"try{require('node:fs').accessSync('dist/index.js')}catch{console.error('[bench] dist/index.js missing - run npm run build first');process.exit(2)}\"",
    "check:package": "node scripts/check-package-consumer.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "26.6.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "2.3.0"
  },
  "bin": {
    "ucz": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/types",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "BENCHMARKS.md",
    "CONSTITUTION.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "license": "MPL-2.0",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
